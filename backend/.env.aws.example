# Fastcase AWS Backend Environment Variables
APP_NAME=Fastcase
APP_ENV=production
DEBUG=false
DOMAIN=fastcase.in
SECRET_KEY=fastcase_aws_production_secret_key_change_in_production_min_32_chars
JWT_SECRET_KEY=fastcase_aws_jwt_secret_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed Frontend Origins
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","https://fastcase.in","https://app.fastcase.in"]

# Database & Cache (overridden by docker compose environment in container)
DATABASE_URL=postgresql://fastcase:change_this_strong_password@postgres:5432/fastcase_db
REDIS_URL=redis://redis:6379/0

# Storage
STORAGE_BACKEND=local
AWS_REGION=ap-south-1
AWS_S3_BUCKET=fastcase-documents

# Razorpay Payment Gateway (Optional - configured in Superadmin or here)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# OpenAI (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
