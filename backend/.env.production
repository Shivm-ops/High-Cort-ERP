# Application
APP_NAME=Fastcase
APP_ENV=production
DEBUG=false
DOMAIN=fastcase.in
SECRET_KEY=CHANGE_THIS_TO_A_64_CHAR_RANDOM_SECRET_KEY_MINIMUM_32_CHARS_OK

# Database (set via docker-compose env override)
DATABASE_URL=postgresql+psycopg2://lagalos:CHANGE_THIS_DB_PASSWORD@postgres:5432/lagalos_db
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=CHANGE_THIS_TO_ANOTHER_64_CHAR_RANDOM_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — allowed frontend origins
ALLOWED_ORIGINS=["https://fastcase.in","https://www.fastcase.in","https://app.fastcase.in","https://admin.fastcase.in"]

# Elasticsearch (optional — disabled by default in VPS mode)
ELASTICSEARCH_URL=http://elasticsearch:9200

# ── Email Service (Authenticated Company Domain: fastcase.in) ──
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USERNAME=bfbe21001@smtp-brevo.com
SMTP_PASSWORD=REPLACE_WITH_BREVO_SMTP_KEY
SMTP_FROM_EMAIL=support@fastcase.in
SMTP_FROM_NAME=Fastcase ERP
SMTP_USE_TLS=true

# Storage (Local droplet storage in /opt/fastcase/backend/uploads)
STORAGE_BACKEND=local

# OpenAI (optional — for AI features)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
