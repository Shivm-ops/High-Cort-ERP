# Application
APP_NAME=Fastcase
APP_ENV=production
DEBUG=false
DOMAIN=fastcase.in
SECRET_KEY=CHANGE_THIS_TO_A_64_CHAR_RANDOM_SECRET_KEY_MINIMUM_32_CHARS_OK

# Database (set via docker-compose env override)
DATABASE_URL=postgresql+psycopg2://lagalos:CHANGE_THIS_DB_PASSWORD@postgres:5432/lagalos_db
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=CHANGE_THIS_TO_ANOTHER_64_CHAR_RANDOM_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — allowed frontend origins
ALLOWED_ORIGINS=["https://fastcase.in","https://www.fastcase.in","https://app.fastcase.in","https://admin.fastcase.in"]

# Elasticsearch (optional — disabled by default in VPS mode)
ELASTICSEARCH_URL=http://elasticsearch:9200

# Email — Amazon SES (Mumbai ap-south-1)
# Get credentials: AWS Console → SES → SMTP Settings → Create SMTP Credentials
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SES_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SES_SMTP_PASSWORD
SMTP_FROM_EMAIL=noreply@fastcase.in
SMTP_FROM_NAME=Fastcase ERP


# AWS S3 (optional — for document uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=fastcase-documents

# OpenAI (optional — for AI features)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
